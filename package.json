{
  "name": "openshift-client-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Download client binaries from the OpenShift download site",
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-actions/openshift-tools-installer"
  },
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "npx webpack --mode=production",
    "clean": "rm -rf out/ dist/",
    "lint": "eslint . --max-warnings=0",
    "generate-ios": "npx action-io-generator -w -o ./src/generated/inputs-outputs.ts",
    "dev-test": "export RUNNER_TEMP=./tmp/; export CLI_INSTALLER_SKIP_CACHE=true; ts-node src/test/test.ts"
  },
  "author": "Red Hat",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@redhat-actions/action-io-generator": "^1.5.0",
    "@types/node": "^22.16.0",
    "@types/semver": "^7.7.0",
    "eslint": "^10.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.35.0",
    "webpack": "^5.108.0",
    "webpack-cli": "^6.0.0"
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.7.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/core": "^5.2.2",
    "@octokit/openapi-types": "^22.2.0",
    "@octokit/plugin-paginate-rest": "^9.2.2",
    "cheerio": "^1.2.0",
    "semver": "^7.8.0"
  }
}
